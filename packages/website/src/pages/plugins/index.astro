---
// The plugin directory: fxbot's vetted plugins, a card each, with a search box (docs/phases/plugin-directory.md).
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import PluginIcon from "../../components/PluginIcon.astro";
import { essentials, listed } from "../../plugins.ts";

const base = import.meta.env.BASE_URL;
const description = "What you can add to fxbot's AI assistants: a computer of their own, routines, subagents, pages, rooms, and more.";
---

<StarlightPage frontmatter={{ title: "Plugins", description, template: "splash", pageActions: false, head: [{ tag: "meta", attrs: { property: "og:title", content: "fxbot plugins" } }] }}>
  <p>
    {description} Each plugin adds to fxbot itself, the app on your machine.
  </p>
  <p>
    These are the plugins fxbot vets. <strong>Browse</strong>, in fxbot's <strong>Plugins</strong>, shows them while unvetted plugins are off, and each costs nothing until it's added.
  </p>
  <p>
    <strong>Essentials</strong> is what most people want from fxbot, offered when you first set it up, and at the top of <strong>Browse</strong>:{" "}
    {essentials.map((plugin, i) => <>{i > 0 && ", "}<a href={`${base}plugins/${plugin.slug}/`}>{plugin.name}</a></>)}.
  </p>
  <input type="search" id="plugin-search" class="fxbot-plugin-search" placeholder="Search plugins" aria-label="Search plugins" autocomplete="off" hidden />
  <ul class="fxbot-plugins not-content">
    {
      listed.map((plugin) => (
        <li data-search={[plugin.name, plugin.creator, plugin.description, plugin.carries].join(" ").toLowerCase()}>
          <a href={`${base}plugins/${plugin.slug}/`}>
            <PluginIcon iconKey={plugin.iconKey} size={40} />
            <span>
              <span class="fxbot-plugin-name">{plugin.name}</span>
              <span class="fxbot-plugin-meta">
                {plugin.creator} · {plugin.carries}
              </span>
              <span class="fxbot-plugin-about">{plugin.description}</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
  <p id="plugin-none" role="status" hidden>No plugin matches.</p>
  <p>
    To add one from anywhere else, see <a href={`${base}docs/how-to/add-a-plugin/`}>Add a plugin</a>. To make one, see <a href={`${base}sdk/how-to/write-a-plugin/`}>Write a plugin</a>.
  </p>
</StarlightPage>

<script>
  // A card shows when every word typed is in its name, creator, description, or what it carries.
  const box = document.getElementById("plugin-search") as HTMLInputElement;
  const none = document.getElementById("plugin-none")!;
  const cards = [...document.querySelectorAll<HTMLElement>(".fxbot-plugins li")];
  box.hidden = false;
  box.addEventListener("input", () => {
    const words = box.value.toLowerCase().split(/\s+/).filter(Boolean);
    for (const card of cards) card.hidden = !words.every((word) => card.dataset.search!.includes(word));
    none.hidden = cards.some((card) => !card.hidden);
  });
</script>
