#!/usr/bin/env bash
# fxbot's command on the machine, in /opt/fxbot beside compose.yaml and .env, for an install made by setup.sh. Run it
# as root. It runs the containers, moves them to a new release, and carries out what the app asks for. The app never
# holds the podman or docker socket: it writes a request into its control folder, and systemd runs `fxbot apply`.
#
#   fxbot up | down | status | logs [service]
#   fxbot compose <args>       Compose itself, on this install's files
#   fxbot update [version]     to the newest release, or the one named
#   fxbot apply                the app's requests
#   fxbot backup [folder]      the database and the plugins' files, into a folder restore takes
#   fxbot restore <folder>     a backup: its database.dump, and its data.tar.gz when there is one
#   fxbot rotate-key           every stored secret sealed again under a new key
#   fxbot embedder cpu|gpu|off  the local embedder for memory search, on the CPU, on a GPU, or not at all
#   fxbot computer on|off      the computer plugin's engine: a user of its own, rootless, with a firewall
#   fxbot herdr on [--user <login>] [--read-only] | off  the herdr plugin's door to herdr's agents
#   fxbot uninstall [--purge] [--yes]  fxbot off this machine, keeping a backup and the key unless --purge
set -euo pipefail

[ "$(id -u)" -eq 0 ] || { echo "fxbot: run it as root, such as: sudo fxbot ${1:-status}" >&2; exit 1; }
here=$(dirname "$(readlink -f "$0")")
# A folder named on the command line is the caller's, from before the cd.
from_here=$PWD
cd "$here"
[ -f .env ] || { echo "fxbot: $here has no .env. Run setup.sh." >&2; exit 1; }
set -a
. ./.env
set +a
var=${FXBOT_ROOT:-}/var/lib/fxbot
control=$var/control
files=${FXBOT_FILES:-https://raw.githubusercontent.com/iammrduncan/fxbot}
releases=${FXBOT_RELEASES_URL:-https://api.github.com/repos/iammrduncan/fxbot/releases/latest}
wait=${FXBOT_UPDATE_TIMEOUT:-300}

# Whether Docker here checks a starting service every 2 seconds: from Docker 25, API 1.44. Compose refuses the setting
# on older engines, and on podman, which reports an older API and ignores it.
quick_checks() {
  [ "${FXBOT_ENGINE:-podman}" = docker ] && [ -f compose.docker.yaml ] &&
    [ "$(printf '1.44\n%s\n' "$(docker version --format '{{.Server.APIVersion}}' 2>/dev/null)" | sort -V | head -n 1)" = 1.44 ]
}
# The compose files and profile: the embedder's profile unless FXBOT_EMBEDDER is off, the GPU file for this engine when
# it's gpu, the computer's file when its setup wrote one, and compose.override.yaml, the owner's own, last. FXBOT_COMPOSE names a Compose binary, when setup.sh found
# that `podman compose` or `docker compose` would run one too old.
compose() {
  local files=compose.yaml
  ! quick_checks || files+=":compose.docker.yaml"
  [ "${FXBOT_EMBEDDER:-cpu}" != gpu ] || files+=":compose.gpu.${FXBOT_ENGINE:-podman}.yaml"
  [ ! -f compose.computer.yaml ] || files+=":compose.computer.yaml"
  [ ! -f compose.override.yaml ] || files+=":compose.override.yaml"
  local profiles=embed
  [ "${FXBOT_EMBEDDER:-cpu}" != off ] || profiles=""
  local run=("${FXBOT_ENGINE:-podman}" compose)
  if [ -n "${FXBOT_COMPOSE:-}" ]; then
    run=("$FXBOT_COMPOSE")
    [ "${FXBOT_ENGINE:-podman}" = docker ] || export DOCKER_HOST=unix:///run/podman/podman.sock
  fi
  COMPOSE_FILE=$files COMPOSE_PROFILES=$profiles PODMAN_COMPOSE_WARNING_LOGS=false "${run[@]}" --project-directory "$here" "$@"
}
# A wait for health with the checks running beside it. podman runs a container's check once each interval (30 s) and
# ignores compose's start_interval, so while a command here waits, the checks run every 2 seconds instead. Docker
# honors start_interval.
checking() {
  while sleep 2; do
    for id in $(compose ps -q 2>/dev/null); do podman healthcheck run "$id" >/dev/null 2>&1 || true; done
  done
}
checked() {
  [ "${FXBOT_ENGINE:-podman}" = podman ] || { "$@"; return; }
  checking >/dev/null 2>&1 &
  local checks=$! code=0
  "$@" || code=$?
  kill "$checks" 2>/dev/null || true
  wait "$checks" 2>/dev/null || true
  return "$code"
}
# podman's containers ask aardvark-dns on their bridge for names. ufw's default deny drops those asks, so each start lets
# port 53 in on the bridge, marked fxbot. firewalld lets them in until it reloads, and netavark's unit puts them back.
# Docker answers names inside each container, and keeps its own firewalld zone.
firewall() {
  [ "${FXBOT_ENGINE:-podman}" = podman ] || return 0
  local iface
  if command -v ufw >/dev/null && ufw status 2>/dev/null | grep -q '^Status: active' &&
    iface=$(podman network inspect "${COMPOSE_PROJECT_NAME:-fxbot}_default" --format '{{.NetworkInterface}}' 2>/dev/null) && [ -n "$iface" ]; then
    ufw allow in on "$iface" to any port 53 comment fxbot >/dev/null 2>&1 || true
  fi
  if command -v firewall-cmd >/dev/null && firewall-cmd --state >/dev/null 2>&1; then
    systemctl enable --now netavark-firewalld-reload.service >/dev/null 2>&1 || true
  fi
}
# Every container started, then a wait for the app alone: the embedder may still be downloading its model.
start() {
  local said
  said=$(checked compose up -d --remove-orphans 2>&1) || { printf '%s\n' "$said" >&2; return 1; }
  firewall
  checked compose up -d --wait --wait-timeout "$wait" fxbot
}
die() {
  echo "fxbot: $*" >&2
  exit 1
}

# An update's steps, for Settings, in status.json. It's renamed into place, so the app never reads half of one.
to=""
steps=()
quote() {
  local s=$1
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//$'\n'/\\n}
  printf '"%s"' "$(printf '%s' "$s" | tr -d '\000-\037')"
}
status() {
  local list=() step
  for step in "${steps[@]}"; do list+=("$(quote "$step")"); done
  local IFS=,
  printf '{"to":%s,"state":%s,"steps":[%s]%s}\n' "$(quote "$to")" "$(quote "$1")" "${list[*]}" "${2:+,\"error\":$(quote "$2")}" >"$control/.status.json"
  mv "$control/.status.json" "$control/status.json"
}
step() {
  steps+=("$1")
  status working
  echo "$1"
}
fail() {
  status failed "$1"
  die "$1"
}

# Whether version $1 is newer than $2. A prerelease such as 0.3.0-rc.1 comes before 0.3.0.
newer() {
  [ "$1" != "$2" ] || return 1
  local a=${1%%-*} b=${2%%-*}
  if [ "$a" = "$b" ]; then
    [ "$1" = "$a" ] && return 0
    [ "$2" = "$b" ] && return 1
  else
    set -- "$a" "$b"
  fi
  [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n 1)" = "$1" ]
}

migrations() { compose exec -T db psql -U fxbot -d fxbot -Atc 'select count(*) from fxbot_migrations' 2>/dev/null || echo 0; }

# A backup in place of the database, which is dropped and made again, so tables a newer release added go too. Then
# the chat files from its tarball, when it has one. The app is stopped first, and the database started if it wasn't;
# `fxbot up` starts the app.
restore() {
  local folder=${1:?name a backup folder, such as $var/backups/<date>-before-<migration>}
  [[ $folder == /* ]] || folder=$from_here/$folder
  [ -f "$folder/database.dump" ] || die "$folder has no database.dump"
  compose stop fxbot >/dev/null 2>&1 || true
  checked compose up -d --wait db >/dev/null 2>&1 || die "the database didn't start. See: fxbot logs db"
  compose exec -T db psql -U fxbot -d postgres -q -c 'drop database if exists fxbot with (force)' -c 'create database fxbot'
  compose exec -T db pg_restore -U fxbot -d fxbot --no-owner --exit-on-error <"$folder/database.dump"
  if [ -f "$folder/data.tar.gz" ]; then
    tar -xzf "$folder/data.tar.gz" -C "$var/data"
    chown -R "$FXBOT_UID:$FXBOT_GID" "$var/data"
  fi
}

# The database, from pg_dump, and the plugins' files, into a folder of their own, as the app's own backups are, so
# restore takes it as it is. The app stops for it, and starts again if it was running, unless the second argument says
# to leave it stopped.
backup() {
  local folder=${1:-$var/backups/$(date -u +%Y-%m-%dT%H-%M-%S-%3NZ)-by-hand} stay=${2:-} running=""
  [[ $folder == /* ]] || folder=$from_here/$folder
  [ ! -e "$folder/database.dump" ] || die "$folder has a backup in it already"
  [ -z "$(compose ps -q --status running fxbot 2>/dev/null)" ] || running=1
  compose stop fxbot >/dev/null 2>&1 || true
  checked compose up -d --wait db >/dev/null 2>&1 || die "the database didn't start. See: fxbot logs db"
  install -d -m 700 "$folder"
  if ! compose exec -T db pg_dump -U fxbot -Fc fxbot </dev/null >"$folder/database.dump" || ! tar -czf "$folder/data.tar.gz" -C "$var/data" .; then
    rm -f "$folder/database.dump" "$folder/data.tar.gz"
    [ -z "$running" ] || [ -n "$stay" ] || checked compose up -d --wait fxbot >/dev/null 2>&1 || true
    die "the backup into $folder failed"
  fi
  # One in the app's own folder is the app's to keep, with its own; one elsewhere is for whoever ran sudo.
  if [[ $folder == "$var/backups/"* ]]; then chown -R "$FXBOT_UID:$FXBOT_GID" "$folder"; elif [ -n "${SUDO_USER:-}" ]; then chown -R "$SUDO_USER:" "$folder"; fi
  [ -z "$running" ] || [ -n "$stay" ] || checked compose up -d --wait fxbot >/dev/null 2>&1 || die "the backup is in $folder, but fxbot didn't start again. See: fxbot logs fxbot"
  # Uninstall says where its own went.
  [ -z "$stay" ] || return 0
  echo "Backed up into $folder: database.dump, and data.tar.gz with the plugins' files."
  echo "It opens only with the key, ${FXBOT_ROOT:-}/etc/fxbot/secret.key: keep a copy of that apart from it."
  [[ $folder != "$var/backups/"* ]] || echo "fxbot keeps only the five newest folders in $var/backups, so copy this one elsewhere to keep it."
}

# Every stored key and token sealed again under a new key, in one transaction, with the app stopped. The new key
# replaces /etc/fxbot/secret.key, and the old one stays beside it as secret.key.old until you remove it.
rotate_key() {
  local key=${FXBOT_ROOT:-}/etc/fxbot/secret.key
  local new=$key.new
  (umask 377 && head -c 32 /dev/urandom | base64 >"$new")
  chown "$FXBOT_UID:$FXBOT_GID" "$new"
  compose stop fxbot >/dev/null 2>&1 || true
  if ! compose run --rm --no-deps -v "$new:/run/fxbot/new.key:ro,z" fxbot node packages/server/src/rotate-key.ts /run/fxbot/new.key >/dev/null; then
    rm -f "$new"
    checked compose up -d --wait fxbot >/dev/null 2>&1 || true
    die "nothing was sealed again, and the old key still works"
  fi
  cp -p "$key" "$key.old" && mv "$new" "$key"
  checked compose up -d --wait fxbot >/dev/null 2>&1
  echo "fxbot runs on the new key. The old one is $key.old: remove it once you're sure."
}

# To a newer release: its compose file, this command, and its images, then a start that waits for health. If the new
# release doesn't come up, the old one runs again, on the backup the new one took before its migrations, if it ran any.
update() {
  exec 9>"$here/.update.lock"
  flock 9
  # Another update may have run while this one waited.
  set -a
  . ./.env
  set +a
  steps=()
  to=${1:-$(curl -fsSL "$releases" | sed -n 's/.*"tag_name": *"v\{0,1\}\([^"]*\)".*/\1/p' | head -n 1)}
  to=${to#v}
  [ -n "$to" ] || fail "Couldn't find the newest release."
  [[ $to =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$ ]] || fail "$to isn't a version such as 0.3.0."
  local from=$FXBOT_VERSION next=$here/.next before why backup
  newer "$to" "$from" || fail "fxbot $from is running, and $to isn't newer."

  step "Getting $to"
  rm -rf "$next" && mkdir -p "$next"
  curl -fsSL "$files/v$to/deploy/compose.yaml" -o "$next/compose.yaml" && curl -fsSL "$files/v$to/deploy/fxbot" -o "$next/fxbot" &&
    curl -fsSL "$files/v$to/deploy/compose.gpu.${FXBOT_ENGINE:-podman}.yaml" -o "$next/compose.gpu.yaml" ||
    fail "Couldn't download $to's files from $files."
  if [ "${FXBOT_ENGINE:-podman}" = docker ]; then
    curl -fsSL "$files/v$to/deploy/compose.docker.yaml" -o compose.docker.yaml || fail "Couldn't download $to's files from $files."
  fi
  # herdr's door, when it's here, comes with each release.
  if [ -f herdr-door ]; then
    curl -fsSL "$files/v$to/deploy/herdr-door" -o "$next/herdr-door" || fail "Couldn't download $to's files from $files."
  fi
  # A release's tags never change, so an image that is here already is the right one.
  FXBOT_VERSION=$to compose -f "$next/compose.yaml" pull --policy missing -q >/dev/null 2>&1 || fail "Couldn't download $to's images."

  before=$(migrations)
  local old
  old=$(compose config --images 2>/dev/null | sort -u)
  cp -p .env .env.back && cp -p compose.yaml compose.yaml.back && cp -p fxbot fxbot.back
  [ ! -f herdr-door ] || cp -p herdr-door herdr-door.back
  cp -p "compose.gpu.${FXBOT_ENGINE:-podman}.yaml" compose.gpu.back 2>/dev/null || true
  sed -i "s/^FXBOT_VERSION=.*/FXBOT_VERSION=$to/" .env
  chmod 755 "$next/fxbot"
  # Renamed into place: this run keeps reading its own copy of the script.
  [ ! -f "$next/herdr-door" ] || { chmod 755 "$next/herdr-door" && mv "$next/herdr-door" herdr-door; }
  mv "$next/compose.yaml" compose.yaml && mv "$next/compose.gpu.yaml" "compose.gpu.${FXBOT_ENGINE:-podman}.yaml" && mv "$next/fxbot" fxbot && rm -rf "$next"
  touch .update-started
  step "Starting $to"
  if FXBOT_VERSION=$to start >/dev/null 2>&1; then
    rm -f .env.back compose.yaml.back fxbot.back compose.gpu.back herdr-door.back
    # The old release's images, by name, now that nothing goes back to them.
    comm -23 <(printf '%s\n' "$old") <(FXBOT_VERSION=$to compose config --images 2>/dev/null | sort -u) |
      while read -r image; do [ -z "$image" ] || "${FXBOT_ENGINE:-podman}" rmi "$image" >/dev/null 2>&1 || true; done
    step "Running $to"
    status done
    return
  fi

  why=$(compose logs --no-color --tail 12 fxbot 2>&1 | sed 's/\x1b\[[0-9;]*[A-Za-z]//g' | tail -n 12)
  step "Going back to $from"
  compose stop fxbot >/dev/null 2>&1 || true
  if [ "$(migrations)" != "$before" ]; then
    backup=$(find "$var/backups" -mindepth 1 -maxdepth 1 -type d -newer .update-started | sort | tail -n 1)
    [ -n "$backup" ] || fail "$to changed the database and didn't start, and there is no backup from before it. fxbot is stopped. See: fxbot logs fxbot"
    restore "$backup" || fail "$to didn't start, and $backup didn't restore. fxbot is stopped. See: fxbot logs"
  fi
  mv .env.back .env && mv compose.yaml.back compose.yaml && mv fxbot.back fxbot
  [ ! -f compose.gpu.back ] || mv compose.gpu.back "compose.gpu.${FXBOT_ENGINE:-podman}.yaml"
  [ ! -f herdr-door.back ] || mv herdr-door.back herdr-door
  FXBOT_VERSION=$from start >/dev/null 2>&1 ||
    fail "$to didn't start, and neither did $from after going back. See: fxbot logs"
  status back "$to didn't start, so fxbot went back to $from.${why:+$'\n\n'$why}"
  die "$to didn't start, so fxbot went back to $from. See: fxbot logs fxbot"
}

# What the machine runs as its local embedder, in embedder-status.json for Settings: the state, the embedder now, and
# the one asked for and why it failed, when there's one.
embedder_status() {
  printf '{"state":%s,"embedder":%s%s%s}\n' "$(quote "$1")" "$(quote "$2")" "${3:+,\"to\":$(quote "$3")}" "${4:+,\"error\":$(quote "$4")}" >"$control/.embedder-status.json"
  mv "$control/.embedder-status.json" "$control/embedder-status.json"
}
cuda=ghcr.io/ggml-org/llama.cpp:server-cuda-b12033
gpu_works() {
  local image=$cuda
  if [ "${FXBOT_ENGINE:-podman}" = docker ]; then
    docker run --rm --gpus all --entrypoint nvidia-smi "$image" -L
  else
    podman run --rm --device nvidia.com/gpu=all --security-opt=label=disable --entrypoint nvidia-smi "$image" -L
  fi >/dev/null 2>&1
}

# The local embedder on the CPU, on a GPU after a trial run reaches one, or not at all. Changing it changes the model,
# so the app fills in new vectors for everything.
embedder() {
  local to=${1:-} from=${FXBOT_EMBEDDER:-cpu}
  case $to in cpu | gpu | off) ;; *) die "name cpu, gpu, or off" ;; esac
  embedder_status working "$from" "$to"
  local had=""
  "${FXBOT_ENGINE:-podman}" image inspect "$cuda" >/dev/null 2>&1 && had=1
  if [ "$to" = gpu ] && ! gpu_works; then
    # The image the trial pulled, 4 GB, unless it was here before.
    [ -n "$had" ] || "${FXBOT_ENGINE:-podman}" rmi "$cuda" >/dev/null 2>&1 || true
    embedder_status failed "$from" "$to" "No GPU answered a trial run. A GPU needs NVIDIA's driver and container toolkit on the machine."
    die "no GPU answered a trial run"
  fi
  if grep -q '^FXBOT_EMBEDDER=' .env; then sed -i "s/^FXBOT_EMBEDDER=.*/FXBOT_EMBEDDER=$to/" .env; else echo "FXBOT_EMBEDDER=$to" >>.env; fi
  FXBOT_EMBEDDER=$to
  if [ "$to" = off ]; then
    compose rm -sf embed >/dev/null 2>&1 || true
  elif ! compose up -d embed >/dev/null 2>&1; then
    embedder_status failed "$from" "$to" "The embedder didn't start. See: fxbot logs embed"
    die "the embedder didn't start. See: fxbot logs embed"
  fi
  embedder_status done "$to"
  echo "The local embedder is $to."
}

# The app's requests, each moved out of the watched folder first, or systemd would start this again.
apply() {
  local request name version
  for request in "$control"/requests/*.json; do
    [ -e "$request" ] || continue
    name=$(basename "$request")
    mv "$request" "$control/.$name"
    case $name in
      update.json)
        version=$(sed -n 's/.*"to" *: *"\([0-9A-Za-z.-]*\)".*/\1/p' "$control/.$name" | head -n 1)
        rm -f "$control/.$name"
        if [ -n "$version" ]; then (update "$version") || true; else echo "fxbot: update.json named no version" >&2; fi
        ;;
      embedder.json)
        version=$(sed -n 's/.*"to" *: *"\([a-z]*\)".*/\1/p' "$control/.$name" | head -n 1)
        rm -f "$control/.$name"
        (embedder "$version") || true
        ;;
      # The app asks only to set the computer up; taking it away is the owner's, with fxbot computer off.
      computer.json)
        version=$(sed -n 's/.*"to" *: *"\([a-z]*\)".*/\1/p' "$control/.$name" | head -n 1)
        rm -f "$control/.$name"
        if [ "$version" = on ]; then (computer on) || true; else echo "fxbot: computer.json asked for ${version:-nothing}, not on" >&2; fi
        ;;
      *)
        rm -f "$control/.$name"
        echo "fxbot: no such request: $name" >&2
        ;;
    esac
  done
}

# What the computer's setup did, in computer-status.json for its plugin: the state, and why it failed.
computer_status() {
  printf '{"state":%s%s}\n' "$(quote "$1")" "${2:+,\"error\":$(quote "$2")}" >"$control/.computer-status.json"
  mv "$control/.computer-status.json" "$control/computer-status.json"
}

# The computer plugin's engine, set up or taken away by the plugin's own setup script, from this release's files: never
# from the plugin's folder, which the app can write. The script writes compose.computer.yaml, which gives the app the
# engine's socket, and starts fxbot again. FXBOT_COMPUTER_NAME names its user, for checks beside a real install.
computer() {
  local to=${1:-} script=$here/computer-setup.sh log remove=()
  case $to in on | off) ;; *) die "name on or off" ;; esac
  [ "$to" = on ] || remove=(--remove)
  computer_status working
  if ! curl -fsSL "$files/v$FXBOT_VERSION/plugins/computer/host/setup.sh" -o "$script.next"; then
    rm -f "$script.next"
    computer_status failed "Couldn't download the computer's setup script for $FXBOT_VERSION from $files."
    die "couldn't download the computer's setup script for $FXBOT_VERSION from $files"
  fi
  mv "$script.next" "$script"
  if ! log=$(bash "$script" --install "$here" --name "${FXBOT_COMPUTER_NAME:-fxbot-computer}" "${remove[@]}" 2>&1); then
    computer_status failed "$(printf '%s\n' "$log" | tail -n 5)"
    die "the computer's setup failed: $(printf '%s\n' "$log" | tail -n 1)"
  fi
  computer_status done
  printf '%s\n' "$log" | tail -n 3
}

# fxbot off the machine. Unless --purge, a backup, the key, and the fxbot user stay, for an install and a restore later;
# the packages setup.sh installed are named, not removed. Each step that fails says so and the rest go on, so a second
# run finishes what a first one left; only a failed backup stops it, before anything is removed.
# herdr's door for the herdr plugin: a socket in the control folder, which the app's container already sees, that runs a
# short list of herdr's commands as herdr's user, from this release's herdr-door (docs/phases/herdr.md). Only root opens
# it: the app can't ask for it, since it lets bots send work to the agents herdr runs here and on its saved machines.
herdr_door() {
  local to=${1:-} user=root read_only="" home bin group label unit=/etc/systemd/system/fxbot-herdr
  shift || true
  while [ $# -gt 0 ]; do
    case $1 in
      --user) [ -n "${2:-}" ] || die "--user takes herdr's login"; user=$2; shift 2 ;;
      --read-only) read_only=" --read-only"; shift ;;
      *) die "herdr on takes --user <login> and --read-only, not $1" ;;
    esac
  done
  case $to in
    off)
      systemctl disable --now fxbot-herdr.socket >/dev/null 2>&1 || true
      systemctl stop 'fxbot-herdr@*.service' >/dev/null 2>&1 || true
      rm -f "$unit.socket" "$unit@.service" "$control/herdr.sock"
      systemctl daemon-reload
      echo "herdr's door is closed."
      return
      ;;
    on) ;;
    *) die "name on or off: sudo fxbot herdr on [--user <login>] [--read-only], or sudo fxbot herdr off" ;;
  esac
  home=$(getent passwd "$user" | cut -d: -f6 || true)
  [ -n "$home" ] || die "there's no user $user. Name herdr's user: sudo fxbot herdr on --user <login>"
  bin=$(runuser -u "$user" -- bash -lc 'command -v herdr' 2>/dev/null | tail -n 1 || true)
  [ -n "$bin" ] || [ ! -x "$home/.local/bin/herdr" ] || bin=$home/.local/bin/herdr
  [ -n "$bin" ] || die "herdr isn't installed for $user. Install it from https://herdr.dev, or name its user with --user"
  # As the door runs it: herdr's user, its home, and nothing else from this shell.
  as_door() { runuser -u "$user" -- env -i HOME="$home" USER="$user" LOGNAME="$user" PATH=/usr/local/bin:/usr/bin:/bin "$bin" "$@"; }
  as_door status server --json 2>/dev/null | grep -q '"running": *true' || die "herdr's server isn't running for $user. Start herdr, then run this again"
  # Each saved machine, as the door reaches it: with no SSH agent. One whose key needs an agent can't be reached.
  while IFS= read -r label; do
    [ -z "$label" ] || echo "herdr can't reach $label with no SSH agent, so the door can't either, until its key is loaded where the door sees it."
  done < <(as_door machine status --json 2>/dev/null | tr -d '\n' | sed 's/": *"/":"/g; s/", *"/","/g' |
    grep -o '"label":"[^"]*","status":"[^"]*"' | grep -v '"status":"reachable"' | sed 's/^"label":"\([^"]*\)".*/\1/')
  if [ ! -f herdr-door ]; then
    curl -fsSL "$files/v$FXBOT_VERSION/deploy/herdr-door" -o herdr-door.next || { rm -f herdr-door.next; die "couldn't download herdr-door for $FXBOT_VERSION from $files"; }
    chmod 755 herdr-door.next && mv herdr-door.next herdr-door
  fi
  group=$(getent group "${FXBOT_GID:?}" | cut -d: -f1 || true)
  printf '%s\n' "[Unit]" "Description=fxbot's door to herdr" "" "[Socket]" "ListenStream=$control/herdr.sock" "Accept=yes" \
    "SocketUser=root" "SocketGroup=${group:-$FXBOT_GID}" "SocketMode=0660" "MaxConnections=64" "" "[Install]" "WantedBy=sockets.target" >"$unit.socket"
  printf '%s\n' "[Unit]" "Description=fxbot's door to herdr" "" "[Service]" "User=$user" "Environment=HERDR_BIN=$bin" \
    "ExecStart=$here/herdr-door$read_only" "StandardInput=socket" "StandardOutput=socket" "StandardError=journal" "RuntimeMaxSec=15min" >"$unit@.service"
  systemctl daemon-reload
  systemctl enable fxbot-herdr.socket >/dev/null 2>&1
  systemctl restart fxbot-herdr.socket || die "the door's socket didn't start. See: journalctl -u fxbot-herdr.socket"
  if [ -n "$read_only" ]; then
    echo "fxbot's app can now list and read herdr's agents, as $user, here and on herdr's saved machines. It can't send them work or start them."
  else
    echo "fxbot's app can now list and read herdr's agents, send them work, and start new ones, as $user, here and on herdr's saved machines."
  fi
  echo "Close it with: sudo fxbot herdr off"
}

uninstall() {
  local purge="" yes="" arg folder="" name=${FXBOT_COMPUTER_NAME:-fxbot-computer} engine=${FXBOT_ENGINE:-podman}
  local port=${FXBOT_PORT:-8787} etc=${FXBOT_ROOT:-}/etc/fxbot moved="" images
  for arg in "$@"; do
    case $arg in --purge) purge=1 ;; --yes) yes=1 ;; *) die "uninstall takes --purge and --yes, not $arg" ;; esac
  done
  echo "fxbot uninstall removes fxbot from this machine:"
  echo "  its containers, its database and model volumes, and its images"
  echo "  the computer: the user $name, its computers and their homes, and its firewall"
  echo "  fxbot.service and fxbot-control, herdr's door if it's open, the fxbot command, and $here"
  if [ -z "$purge" ]; then
    echo "It keeps, so you can install again and restore:"
    echo "  a backup of the database and plugins' files, in $var/backups"
    echo "  the key that opens its stored keys and tokens, $etc/secret.key"
    echo "  the user fxbot, which owns them"
    echo "To remove those too: sudo fxbot uninstall --purge"
  else
    echo "  $var and $etc: every backup, the key, and the app's settings, and the user fxbot"
  fi
  if [ -z "$yes" ]; then
    [ -t 0 ] || die "add --yes to uninstall without a question"
    read -r -p "Uninstall fxbot? [y/N] " arg
    case $arg in y | Y | yes) ;; *) echo "Nothing was changed." && return 0 ;; esac
  fi

  systemctl disable --now fxbot-control.path >/dev/null 2>&1 || true
  systemctl stop fxbot-control.service >/dev/null 2>&1 || true
  if [ -z "$purge" ]; then
    if "$engine" volume inspect "${COMPOSE_PROJECT_NAME:-fxbot}_pgdata" >/dev/null 2>&1; then
      folder=$var/backups/$(date -u +%Y-%m-%dT%H-%M-%S-%3NZ)-uninstall
      if ! (backup "$folder" stay); then
        systemctl enable --now fxbot-control.path >/dev/null 2>&1 || true
        start >/dev/null 2>&1 || true
        die "the backup failed, so nothing was removed, and fxbot runs again"
      fi
    else
      echo "There's no database left to back up."
    fi
  fi
  # The computer's compose file first, so its script doesn't start fxbot again. Its saved copy takes it away with no
  # network: it's the one that last set the computer up.
  rm -f compose.computer.yaml
  if [ -f compose.override.yaml ] && grep -q '^# Written by the computer plugin' compose.override.yaml; then rm -f compose.override.yaml; fi
  if id "$name" >/dev/null 2>&1 || [ -f "${FXBOT_ROOT:-}/etc/fxbot/$name.nft" ]; then
    [ -f computer-setup.sh ] || curl -fsSL "$files/v$FXBOT_VERSION/plugins/computer/host/setup.sh" -o computer-setup.sh || true
    if [ -f computer-setup.sh ]; then
      bash computer-setup.sh --install "$here" --name "$name" --remove >/dev/null || echo "The computer's setup couldn't take everything away: see $here/computer-setup.sh --remove"
    else
      echo "The computer's setup script isn't here, and couldn't be downloaded, so its user $name stays."
    fi
  fi
  [ ! -f /etc/systemd/system/fxbot-herdr.socket ] || herdr_door off >/dev/null
  systemctl disable --now fxbot >/dev/null 2>&1 || true
  images=$(compose config --images 2>/dev/null || true)
  compose down --volumes --rmi all --remove-orphans >/dev/null 2>&1 || echo "Compose couldn't take everything down: see fxbot compose ps -a"
  # fxbot's own images at every version, and the GPU trial's, by name; never a prune.
  images+=$'\n'$("$engine" images --format '{{.Repository}}:{{.Tag}}' 2>/dev/null | grep "^${FXBOT_IMAGE:-ghcr.io/iammrduncan/fxbot}:" || true)$'\n'$cuda
  for arg in $(printf '%s\n' "$images" | sort -u); do "$engine" rmi "$arg" >/dev/null 2>&1 || true; done
  if command -v ufw >/dev/null; then
    for arg in $(ufw status numbered 2>/dev/null | sed -n 's/^\[ *\([0-9]*\)\].*# fxbot$/\1/p' | sort -rn); do ufw --force delete "$arg" >/dev/null 2>&1 || true; done
  fi
  local recorded=()
  [ ! -f "$etc/packages" ] || mapfile -t recorded <"$etc/packages"
  [ ! -L "$here/current" ] || moved=1
  rm -f /etc/systemd/system/fxbot.service /etc/systemd/system/fxbot-control.path /etc/systemd/system/fxbot-control.service
  systemctl daemon-reload >/dev/null 2>&1 || true
  [ "$(readlink -f /usr/local/bin/fxbot 2>/dev/null)" != "$here/fxbot" ] || rm -f /usr/local/bin/fxbot
  # This script stays open in bash, so it carries on once its folder is gone.
  rm -rf "$here"
  if [ -n "$purge" ]; then
    rm -rf "$var" "$etc"
    userdel fxbot >/dev/null 2>&1 || true
    groupdel fxbot >/dev/null 2>&1 || true
  fi

  echo
  echo "fxbot is uninstalled."
  if [ -n "$folder" ]; then
    echo "Its backup is in $folder, and its key in $etc/secret.key. To install again on them:"
    echo "  curl -fsSL https://fxbot.sh/setup.sh | sudo bash"
    echo "  sudo fxbot restore $folder && sudo fxbot up"
  fi
  local packages=() files=() line
  for line in "${recorded[@]:1}"; do if [[ $line == /* ]]; then files+=("$line"); else packages+=("$line"); fi; done
  if [ ${#packages[@]} -gt 0 ]; then
    echo "setup.sh installed these, which stay. If nothing else here uses them:"
    case ${recorded[0]} in
      apt) echo "  sudo apt-get purge ${packages[*]}" ;;
      dnf) echo "  sudo dnf remove ${packages[*]}" ;;
      zypper) echo "  sudo zypper remove --clean-deps ${packages[*]}" ;;
      pacman) echo "  sudo pacman -Rns ${packages[*]}" ;;
    esac
  fi
  [ ${#files[@]} -eq 0 ] || echo "It added Docker's package repository too, in: ${files[*]}"
  images=$("$engine" images --format '{{.Repository}}:{{.Tag}}' 2>/dev/null | grep -E '^(docker\.io/pgvector/pgvector|ghcr\.io/ggml-org/llama\.cpp):' || true)
  [ -z "$images" ] || echo "Older releases' images stay, since another project may use them: sudo $engine rmi" $images
  if command -v tailscale >/dev/null && tailscale serve status 2>/dev/null | grep -q ":$port\b"; then
    echo "Tailscale still serves port $port: sudo tailscale serve reset"
  fi
  [ -z "$moved" ] || echo "The 0.2 install's database is still in the machine's Postgres: sudo -u postgres dropdb fxbot"
  echo "On your devices, the installed app goes from the home screen like any other, and keys made for fxbot are revoked"
  echo "at each provider.${purge:+ Each device paired at web.fxbot.sh can Forget it, under its devices there.}"
}

case ${1:-} in
  up) start ;;
  down) compose down ;;
  status)
    echo "fxbot $FXBOT_VERSION, on $FXBOT_ENGINE, with the local embedder ${FXBOT_EMBEDDER:-cpu}"
    if curl -fs -o /dev/null --max-time 5 "http://127.0.0.1:${FXBOT_PORT:-8787}/api/health"; then
      echo "fxbot answers at http://127.0.0.1:${FXBOT_PORT:-8787}"
    else
      echo "fxbot doesn't answer. See: sudo fxbot logs fxbot"
    fi
    compose ps
    if [ -f /etc/systemd/system/fxbot-herdr.socket ]; then
      echo
      echo "herdr's door is open, as $(sed -n 's/^User=//p' /etc/systemd/system/fxbot-herdr@.service)$(grep -q -- '--read-only' /etc/systemd/system/fxbot-herdr@.service && echo ", read-only"). Close it with: sudo fxbot herdr off"
    fi
    if [ -L "$here/current" ]; then
      echo
      echo "The 0.2 install that moved into containers is still here. Once you're sure, remove it:"
      echo "  rm -rf $here/repo $here/releases $here/current $here/fxbot-0.2.service $here/fxbot-0.2.env"
      echo "  sudo -u postgres dropdb fxbot"
      echo "To go back to it instead: fxbot down, then put $here/fxbot-0.2.env back as /etc/fxbot/fxbot.env and"
      echo "$here/fxbot-0.2.service as /etc/systemd/system/fxbot.service, and: systemctl daemon-reload && systemctl start fxbot"
    fi
    ;;
  # It follows only on a terminal: piped, as an agent runs it, it ends.
  logs) if [ -t 1 ]; then compose logs -f --tail 100 "${@:2}"; else compose logs --tail 100 "${@:2}"; fi ;;
  compose) compose "${@:2}" ;;
  update) update "${2:-}" ;;
  apply) apply ;;
  backup) backup "${2:-}" ;;
  restore) restore "${2:-}" ;;
  rotate-key) rotate_key ;;
  embedder) embedder "${2:-}" ;;
  computer) computer "${2:-}" ;;
  herdr) herdr_door "${@:2}" ;;
  uninstall) uninstall "${@:2}" ;;
  *)
    sed -n '6,16p' "$0" | sed 's/^# //'
    exit 1
    ;;
esac
