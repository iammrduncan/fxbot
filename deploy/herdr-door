#!/usr/bin/env bash
# fxbot's door to herdr. systemd runs it once for each connection to the socket in fxbot's control folder, as herdr's
# user, with the connection as stdin and stdout: `fxbot herdr on` writes those units, and only root runs that. It reads
# one herdr command, its words separated by NUL bytes, checks every word against the commands below, and runs herdr's
# CLI with them, or answers `refused` in herdr's own shape. No word is ever read by a shell. It sources nothing, so it
# never sees fxbot's .env. It types only into a pane with an agent in it. With --read-only it takes only the commands
# that look (docs/_completed/phases/herdr.md and herdr-terminals.md). Its `terminal` runs herdr's own client for a
# terminal in fxbot's page, which can open a pane, a shell as herdr's user (docs/phases/herdr-screen.md).
set -uo pipefail
export LC_ALL=C
read_only=0
[ "${1:-}" = --read-only ] && read_only=1
herdr=${HERDR_BIN:-herdr}

refuse() {
  printf '{"error":{"code":"refused","message":"%s"}}\n' "fxbot's door to herdr refuses that: $1"
  exit 0
}
writes() { [ "$read_only" = 0 ] || refuse "it's read-only, so it takes no prompts, keys, text, terminals, workspaces, tabs, or starts"; }
# A pane with an agent in it, on the same machine, as herdr sees it now: never one with only a shell.
agent_in() { [[ $("$herdr" "${machine[@]}" agent get "$1" 2>&1) == *'"result":{"agent":{'* ]] || refuse "no agent is in pane $1"; }

# One command of at most 64 KiB: words, each ended by a NUL, up to an empty one or the end. A terminal's bytes follow
# its empty word, for herdr's client: bash reads a socket a byte at a time, so they're left for it.
words=() size=0
while IFS= read -r -d '' -n 65537 -t 30 word; do
  [ -n "$word" ] || break
  size=$((size + ${#word} + 1))
  [ "$size" -le 65536 ] || refuse "a command is at most 64 KiB"
  words+=("$word")
done
[ "${#words[@]}" -gt 0 ] || refuse "no command"

# Each kind of word. herdr counts ids past 9 with letters, as in wB:pA.
target='^([a-z][a-z0-9_-]{0,31}|w[0-9A-Za-z]{1,9}:p[0-9A-Za-z]{1,9})$'
name='^[a-z][a-z0-9_-]{0,31}$'
workspace='^w[0-9A-Za-z]{1,9}$'
pane='^w[0-9A-Za-z]{1,9}:p[0-9A-Za-z]{1,9}$'
tab='^w[0-9A-Za-z]{1,9}:t[0-9A-Za-z]{1,9}$'
number='^[1-9][0-9]{0,8}$'
key='^([!-~]|enter|return|esc|escape|tab|shift\+tab|backspace|space|up|down|left|right|shift\+(up|down|left|right)|f([1-9]|1[0-2])|(ctrl|alt)\+[!-~])$'
kinds=' pi claude codex gemini cursor devin agy cline omp mastracode opencode copilot kimi kiro droid amp grok hermes kilo qodercli qwen letta maki muse '
plain() { [[ -n $1 && ${#1} -le $2 && $1 != -* && ! $1 =~ [[:cntrl:]] ]]; }
path() { [[ ${#1} -le 1024 && ! $1 =~ [[:cntrl:]] && ( $1 == /* || $1 == "~" || $1 == "~/"* ) ]]; }
within() { [[ $1 =~ $number ]] && [ "$1" -ge "$2" ] && [ "$1" -le "$3" ]; }

# herdr's client in a pseudo-terminal, for `terminal`: the plugin's fxbot/terminal.py, the same. Its input is framed:
# a byte for the kind, four for the length, then the payload; kind 0 is typed bytes, and kind 1 a new size.
read -r -d '' terminal_py <<'PY'
import fcntl, os, pty, select, signal, struct, sys, termios

def size(fd, rows, cols):
    fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack("HHHH", max(1, min(rows, 500)), max(1, min(cols, 500)), 0, 0))

def send(fd, data):
    while data:
        data = data[os.write(fd, data):]

rows, cols, argv = int(sys.argv[1]), int(sys.argv[2]), sys.argv[3:]
pid, fd = pty.fork()
if pid == 0:
    size(0, rows, cols)
    os.environ["TERM"] = "xterm-256color"
    os.execvp(argv[0], argv)
waiting = b""
try:
    while True:
        ready, _, _ = select.select([fd, 0], [], [])
        if fd in ready:
            try:
                drawn = os.read(fd, 65536)
            except OSError:
                drawn = b""
            if not drawn:
                break
            send(1, drawn)
        if 0 in ready:
            got = os.read(0, 65536)
            if not got:
                break
            waiting += got
            while len(waiting) >= 5:
                kind, length = waiting[0], struct.unpack(">I", waiting[1:5])[0]
                if length > 1 << 20:
                    raise SystemExit(1)
                if len(waiting) < 5 + length:
                    break
                payload, waiting = waiting[5 : 5 + length], waiting[5 + length :]
                if kind == 0:
                    send(fd, payload)
                elif kind == 1 and length == 4:
                    size(fd, *struct.unpack(">HH", payload))
except (BrokenPipeError, ConnectionResetError):
    pass
finally:
    for sig in (signal.SIGHUP, signal.SIGKILL):
        try:
            os.kill(pid, sig)
            os.waitpid(pid, 0) if sig == signal.SIGKILL else None
        except (ProcessLookupError, ChildProcessError):
            break
PY

machine=()
if [ "${words[0]}" = --machine ]; then
  plain "${words[1]:-}" 64 || refuse "a machine's label is up to 64 characters"
  machine=(--machine "${words[1]}")
  words=("${words[@]:2}")
fi
w=("${words[@]}" "" "" "" "" "" "" "" "")
n=${#words[@]}

case "${w[0]} ${w[1]}" in
  "door ")
    [ "$n" = 1 ] && [ ${#machine[@]} = 0 ] || refuse "door takes nothing more"
    printf '{"door":{"readOnly":%s,"user":"%s"}}\n' "$([ "$read_only" = 1 ] && echo true || echo false)" "$(id -un)"
    exit 0
    ;;
  "sessions ")
    # Claude Code's own names for its running sessions, by id, from the file it keeps for each: only those two fields.
    [ "$n" = 1 ] && [ ${#machine[@]} = 0 ] || refuse "sessions takes nothing more, on this machine only"
    id_re='"sessionId": *"([0-9a-f-]{36})"' name_re='"name": *"([A-Za-z0-9._-]{1,64})"' out=""
    for file in "$HOME"/.claude/sessions/*.json; do
      [ -f "$file" ] || continue
      json=$(head -c 65536 "$file")
      [[ $json =~ $id_re ]] || continue
      id=${BASH_REMATCH[1]}
      [[ $json =~ $name_re ]] || continue
      out+="${out:+,}{\"id\":\"$id\",\"name\":\"${BASH_REMATCH[1]}\"}"
    done
    printf '{"sessions":[%s]}\n' "$out"
    exit 0
    ;;
  "status server") [ "$n" = 3 ] && [ "${w[2]}" = --json ] || refuse "status server --json only" ;;
  "machine list" | "machine status")
    [ "$n" = 3 ] && [ "${w[2]}" = --json ] && [ ${#machine[@]} = 0 ] || refuse "machine list or status --json, on this machine only"
    ;;
  "api snapshot") [ "$n" = 2 ] || refuse "api snapshot takes nothing more" ;;
  "workspace get") [ "$n" = 3 ] && [[ ${w[2]} =~ $workspace ]] || refuse "workspace get takes a workspace id" ;;
  "agent get") [ "$n" = 3 ] && [[ ${w[2]} =~ $target ]] || refuse "agent get takes an agent's name or pane id" ;;
  "agent read")
    [ "$n" = 7 ] && [[ ${w[2]} =~ $target ]] && [ "${w[3]}" = --source ] && [[ ${w[4]} == recent-unwrapped || ${w[4]} == visible ]] &&
      [ "${w[5]}" = --lines ] && within "${w[6]}" 1 1000 || refuse "agent read <agent> --source recent-unwrapped|visible --lines 1-1000"
    ;;
  "agent wait")
    [ "$n" = 5 ] && [[ ${w[2]} =~ $target ]] && [ "${w[3]}" = --timeout ] && within "${w[4]}" 1 600000 || refuse "agent wait <agent> --timeout 1-600000"
    ;;
  "agent prompt")
    writes
    [ "$n" = 7 ] && [[ ${w[2]} =~ $target ]] && [ -n "${w[3]}" ] && [ ${#w[3]} -le 16384 ] && [ "${w[4]}" = --wait ] &&
      [ "${w[5]}" = --timeout ] && within "${w[6]}" 1 600000 || refuse "agent prompt <agent> <text up to 16 KiB> --wait --timeout 1-600000"
    ;;
  "workspace create")
    writes
    [ "$n" = 7 ] && [ "${w[2]}" = --label ] && [ "${w[3]}" = "fxbot bots" ] && [ "${w[4]}" = --cwd ] && path "${w[5]}" && [ "${w[6]}" = --no-focus ] ||
      refuse "workspace create --label \\\"fxbot bots\\\" --cwd <path> --no-focus"
    ;;
  "tab create")
    writes
    [ "$n" = 9 ] && [ "${w[2]}" = --workspace ] && [[ ${w[3]} =~ $workspace ]] && [ "${w[4]}" = --label ] && [[ ${w[5]} =~ $name ]] &&
      [ "${w[6]}" = --cwd ] && path "${w[7]}" && [ "${w[8]}" = --no-focus ] || refuse "tab create --workspace <id> --label <name> --cwd <path> --no-focus"
    ;;
  "tab rename")
    writes
    [ "$n" = 4 ] && [[ ${w[2]} =~ $tab ]] && [[ ${w[3]} =~ $name ]] || refuse "tab rename <tab id> <name>"
    ;;
  "pane rename")
    writes
    [ "$n" = 4 ] && [[ ${w[2]} =~ $pane ]] && plain "${w[3]}" 60 || refuse "pane rename <pane id> <label of up to 60 characters>"
    ;;
  "terminal "*)
    # herdr's own client in a pseudo-terminal: the whole screen, or one agent attached, with the rows and columns given.
    writes
    [ ${#machine[@]} = 0 ] && within "${w[1]}" 1 500 && within "${w[2]}" 1 500 && { [ "$n" = 3 ] || { [ "$n" = 4 ] && [[ ${w[3]} =~ $pane ]]; }; } ||
      refuse "terminal <rows> <cols> [<pane>], on this machine only"
    [ "$n" = 3 ] || agent_in "${w[3]}"
    command -v python3 >/dev/null || refuse "herdr's terminal needs python3 on this machine"
    attach=()
    [ "$n" = 3 ] || attach=(agent attach "${w[3]}")
    exec python3 -I -c "$terminal_py" "${w[1]}" "${w[2]}" "$herdr" "${attach[@]}"
    ;;
  "pane read")
    [ "$n" = 9 ] && [[ ${w[2]} =~ $pane ]] && [ "${w[3]}" = --source ] && [[ ${w[4]} == visible || ${w[4]} == recent ]] && [ "${w[5]}" = --format ] &&
      [ "${w[6]}" = ansi ] && [ "${w[7]}" = --lines ] && within "${w[8]}" 1 1000 || refuse "pane read <pane> --source visible|recent --format ansi --lines 1-1000"
    agent_in "${w[2]}"
    ;;
  "pane send-keys")
    writes
    [ "$n" -ge 4 ] && [ "$n" -le 34 ] && [[ ${w[2]} =~ $pane ]] || refuse "pane send-keys <pane> and 1 to 32 keys"
    for k in "${words[@]:3}"; do [[ ${#k} -le 16 && $k =~ $key ]] || refuse "a key is one character or one of herdr's key names"; done
    agent_in "${w[2]}"
    ;;
  "pane send-text")
    writes
    [ "$n" = 4 ] && [[ ${w[2]} =~ $pane ]] && [ -n "${w[3]}" ] && [ ${#w[3]} -le 4096 ] && [[ ! ${w[3]} =~ [[:cntrl:]] ]] ||
      refuse "pane send-text <pane> <text of up to 4 KiB, with no control characters>"
    agent_in "${w[2]}"
    ;;
  "agent start")
    writes
    [ "$n" = 9 ] && [[ ${w[2]} =~ $name ]] && [ "${w[3]}" = --kind ] && [[ $kinds == *" ${w[4]} "* ]] && [ "${w[5]}" = --pane ] &&
      [[ ${w[6]} =~ $pane ]] && [ "${w[7]}" = --timeout ] && within "${w[8]}" 3001 300000 ||
      refuse "agent start <name> --kind <kind> --pane <pane> --timeout 3001-300000, and nothing after it"
    ;;
  *) refuse "it isn't one of the commands fxbot's bots may use" ;;
esac

exec timeout -k 5 630 "$herdr" "${machine[@]}" "${words[@]}" 2>&1
