{
  "name": "fxbot",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "repository": "https://github.com/iammrduncan/fxbot",
  "workspaces": [
    "packages/sdk",
    "packages/server",
    "packages/ui",
    "packages/website"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "npm run dev -w @fxbot/ui",
    "server": "node --env-file-if-exists=.env packages/server/src/index.ts",
    "prod": "npm run build && npm run server",
    "build": "npm run build -w @fxbot/ui",
    "build-site": "npm run build -w @fxbot/website",
    "typecheck": "npm run typecheck --workspaces && tsc -p plugins/tsconfig.json && node scripts/check-plugins.mjs",
    "rotate-key": "node --env-file-if-exists=.env packages/server/src/rotate-key.ts",
    "shots": "node scripts/screenshots/shoot.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
